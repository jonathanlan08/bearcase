# ---- BearCase API (apps/api) ----------------------------------------------------------
# All settings are optional; the defaults run a zero-infrastructure local demo.
BEARCASE_ENV=development
BEARCASE_SECRET_KEY=change-me-to-a-long-random-string

# SQLite by default. PostgreSQL: postgresql+psycopg://bearcase:bearcase@localhost:5432/bearcase
# BEARCASE_DATABASE_URL=sqlite:///./data/bearcase.db

# Storage: local (default) or s3 (AWS S3 / MinIO). Keys are generated server-side.
BEARCASE_STORAGE_BACKEND=local
# BEARCASE_S3_BUCKET=bearcase
# BEARCASE_S3_ENDPOINT_URL=http://localhost:9000
# BEARCASE_S3_REGION=us-east-1

# Model providers
# Extraction and reports: mock (deterministic, no key) or anthropic
BEARCASE_AI_PROVIDER=mock
BEARCASE_AI_MODEL=claude-opus-5
# Chat (Ask the deal): auto picks the first key found in this order: anthropic, openai, gemini,
# groq, openrouter, ollama (when OLLAMA_HOST is set), else the rule-based composer.
# The native names below work here and in the environment; BEARCASE_-prefixed names work too.
# GEMINI_API_KEY=                        (free tier) https://aistudio.google.com/apikey
# GROQ_API_KEY=                          (free tier) https://console.groq.com/keys
# OPENROUTER_API_KEY=                    (free tier on :free models) https://openrouter.ai/keys
# OLLAMA_HOST=http://127.0.0.1:11434     (free, local, no key) run `ollama pull qwen3:8b` first
# OPENAI_API_KEY=                        (prepaid credits) https://platform.openai.com/api-keys
# ANTHROPIC_API_KEY=sk-ant-...           (prepaid credits) https://platform.claude.com/settings/keys
# Aliases: GOOGLE_API_KEY also works for Gemini; ANTHROPIC_AUTH_TOKEN also counts as an Anthropic credential.
BEARCASE_CHAT_PROVIDER=auto
# BEARCASE_CHAT_MODEL=                   (optional) overrides the provider's default model
# Chat speed on free tiers (defaults shown; see docs/deployment.md). The picker is off so everyone gets the
# default model; a busy model hands over to the next id in its fallback chain (chat/providers.py) instead of
# retrying; a 429 never switches, because the quota is shared by every user of the deployment.
# BEARCASE_CHAT_MODEL_PICKER=false        true shows the model picker in the chat panel
# BEARCASE_CHAT_MAX_OUTPUT_TOKENS=2048    output cap per chat request
# BEARCASE_CHAT_REASONING_EFFORT=low      none, low, medium, or high, for providers that accept it
# BEARCASE_CHAT_MODEL_FALLBACK=true       false keeps one model and reports the provider's error instead
# BEARCASE_CHAT_BRIEF_TTL_SECONDS=300     how long a cached deal brief (chat/brief.py) is trusted before a recheck
# Custom OpenAI-compatible server: set BEARCASE_CHAT_PROVIDER=custom plus the two lines below.
# https is required except for loopback/private-network hosts.
# BEARCASE_CHAT_BASE_URL=https://llm.example.com/v1
# BEARCASE_CHAT_API_KEY=
# BEARCASE_CHAT_BASE_URL next to a named provider's key routes that provider through your own gateway instead.

# Job runner: thread (in-process, default), sync (tests), poll (external `bearcase worker`)
BEARCASE_JOB_RUNNER=thread

# Production (defaults shown). BEARCASE_ENV=production refuses the default secret key and logs a warning for
# each of: a localhost CORS origin, SQLite, local storage, `auto` chat with no key, a disabled limiter. Run
# `bearcase migrate` and then `bearcase doctor` before the first start; production does not migrate on start.
# BEARCASE_CORS_ORIGINS=["http://localhost:3000"]   JSON list of the web app's origins, no trailing slash
# BEARCASE_RATE_LIMIT_ENABLED=true                  token bucket per user on upload, processing, chat, ask, report
# BEARCASE_RATE_LIMIT_PER_MINUTE=60
# BEARCASE_TRUST_PROXY_HEADERS=false                true only behind a proxy that appends to X-Forwarded-For
# BEARCASE_MAX_UPLOAD_BYTES=26214400                25 MB
# BEARCASE_MAX_DOCUMENTS_PER_DEAL=50
# BEARCASE_MAX_STORAGE_BYTES_PER_USER=524288000     500 MB
# BEARCASE_SESSION_TTL_HOURS=336                    14 days
# BEARCASE_DEMO_RETENTION_DAYS=14

# ---- Web (apps/web) -------------------------------------------------------------------
BEARCASE_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-name/bearcase
